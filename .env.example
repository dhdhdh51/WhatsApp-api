# Copy to .env and fill in:  cp .env.example .env && chmod 640 .env
# Generate secrets with:      openssl rand -hex 32

# ---- app
APP_NAME="BC Daily Report"
APP_URL=https://reports.example.com
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=false

# ---- MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bc_report
DB_USER=bc_report
DB_PASS=change-me-strong-password

# ---- WAHA (docker-compose.yml reads these too)
WAHA_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_ENGINE=WEBJS
WAHA_API_KEY=change-me-openssl-rand-hex-32
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-dashboard-password
# 1 = also store the webhook in the WAHA session config when you press "Create / start session"
# (only if you removed WHATSAPP_HOOK_URL from docker-compose.yml – otherwise events arrive twice)
WAHA_SESSION_WEBHOOK=0

# ---- webhook signature (HMAC-SHA512 key shared with WAHA), min 16 chars
WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# ---- admin panel security
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- queue worker: max seconds one worker process keeps running (cron restarts it every minute)
WORKER_MAX_RUNTIME=3300

# ---- Firebase push (service account JSON, keep outside public/ and out of git)
FIREBASE_SA_FILE=/www/wwwroot/bc.bharatseo.site/storage/firebase-sa.json
